# Relationships, level by level. Tags: Runtime marks calls that exist only while a request runs
# (they are hidden in the static component views), Async marks work done through the queue,
# Implements marks an adapter that implements a port.

# --- People and systems
attendee -> seatlock "Registers for workshops, joins the waitlist, cancels" "HTTPS"
organizer -> seatlock "Checks seats and registrations" "HTTPS"
operator -> github "Pushes code, reviews pull requests" "Git, GitHub"
operator -> aws "Deploys infrastructure and releases" "CDK, AWS CLI"
github -> seatlock "Builds, tests and load-tests" "GitHub Actions"
aws -> seatlock "Hosts" "ECS, RDS, ElastiCache, CloudFront, S3"
seatlock -> email "Sends the promotion email" "SMTP or SES API" "Async"

# --- Containers
attendee -> spa "Uses" "HTTPS"
organizer -> spa "Uses" "HTTPS"
spa -> api "Calls" "JSON over HTTPS, token authentication"
api -> database "Reads and writes. Takes row locks" "SQL"
api -> redis "Caches the public list and counts requests for rate limits" "Redis protocol"
api -> redis "Sends promote_waitlist tasks after commit" "Celery (Redis)" "Async"
worker -> redis "Takes tasks from the queue" "Celery (Redis)" "Async"
worker -> redis "Invalidates the list cache after commit" "Redis protocol" "Async"
worker -> database "Reads waitlists, confirms seats. Takes row locks" "SQL" "Async"
worker -> email "Sends the promotion email" "SMTP or SES API" "Async"
operator -> loadTest "Runs" "docker compose exec, or GitHub Actions"
loadTest -> api "Sends the requests" "HTTP"
loadTest -> database "Creates test data, reads the result, deletes the data" "SQL"

# --- Single-page app components
appShell -> authPanel "Shows when signed out" "TypeScript call"
appShell -> workshopList "Renders one card per workshop" "TypeScript call"
appShell -> dashboard "Shows to staff" "TypeScript call"
appShell -> themeToggle "Shows" "TypeScript call"
appShell -> session "Reads the user" "TypeScript call"
appShell -> apiClient "Loads workshops, registers, cancels" "TypeScript call"
authPanel -> session "Logs in, signs up" "TypeScript call"
dashboard -> apiClient "Loads seats and registrations" "TypeScript call"
session -> apiClient "Calls login, sign-up, logout and me" "TypeScript call"
apiClient -> api "Calls the API" "JSON over HTTPS"

# --- API components: callers
spa -> workshopsApi "Lists, registers, cancels" "JSON over HTTPS"
spa -> organizerApi "Loads the dashboard" "JSON over HTTPS"
spa -> accountsApi "Signs up, logs in, logs out" "JSON over HTTPS"

# --- API components: static structure
aws -> healthApi "The load balancer checks it" "HTTP"
workshopsApi -> rateLimits "Applies" "Python call"
accountsApi -> rateLimits "Applies" "Python call"
rateLimits -> redis "Counts requests" "Redis protocol"
workshopsApi -> compositionRoot "Gets the register and cancel use cases" "Python call"
workshopsApi -> queries "Reads the list and the user's registrations" "Python call"
workshopsApi -> listCache "Reads and fills the cached list" "Python call"
organizerApi -> queries "Reads seats, waitlist and registrations" "Python call"
accountsApi -> database "Reads and writes users and tokens" "SQL"
compositionRoot -> registerUseCase "Builds" "Python call"
compositionRoot -> cancelUseCase "Builds" "Python call"
compositionRoot -> promoteUseCase "Builds" "Python call"
compositionRoot -> unitOfWork "Chooses a new one for each call" "Python call" "Wiring"
compositionRoot -> repositories "Chooses" "Python call" "Wiring"
compositionRoot -> listCache "Chooses" "Python call" "Wiring"
compositionRoot -> queueAdapter "Chooses" "Python call" "Wiring"
compositionRoot -> notifier "Chooses" "Python call" "Wiring"
registerUseCase -> ports "Depends on" "Python call"
cancelUseCase -> ports "Depends on" "Python call"
promoteUseCase -> ports "Depends on" "Python call"
registerUseCase -> entities "Applies the seat rules of" "Python call"
cancelUseCase -> entities "Applies the seat rules of" "Python call"
promoteUseCase -> entities "Applies the seat rules of" "Python call"
unitOfWork -> ports "Implements" "Python call" "Implements"
repositories -> ports "Implements" "Python call" "Implements"
listCache -> ports "Implements" "Python call" "Implements"
queueAdapter -> ports "Implements" "Python call" "Implements"
notifier -> ports "Implements" "Python call" "Implements"
repositories -> models "Reads and writes rows through" "Python call"
queries -> models "Queries" "Python call"
adminSite -> models "Edits rows directly" "Python call" "Bypass"
models -> database "Defines the tables and constraints" "SQL"
listCache -> redis "Reads and bumps the version key, stores pages" "Redis protocol"
queueAdapter -> redis "Enqueues promote_waitlist" "Celery (Redis)" "Async"
notifier -> email "Sends the promotion email. Runs in the worker" "SMTP or SES API" "Async"

# --- API components: calls while a request runs
workshopsApi -> registerUseCase "execute(user_id, workshop_id)" "Python call" "Runtime"
workshopsApi -> cancelUseCase "execute(user_id, registration_id)" "Python call" "Runtime"
registerUseCase -> repositories "Locks, finds, counts, adds (through the ports)" "Python call" "Runtime"
cancelUseCase -> repositories "Locks, loads, saves (through the ports)" "Python call" "Runtime"
promoteUseCase -> repositories "Locks, counts, loads the waitlist, saves (through the ports)" "Python call" "Runtime"
registerUseCase -> unitOfWork "Opens the transaction, registers callbacks" "Python call" "Runtime"
cancelUseCase -> unitOfWork "Opens the transaction, registers callbacks" "Python call" "Runtime"
promoteUseCase -> unitOfWork "Opens the transaction, registers callbacks" "Python call" "Runtime"
promoteUseCase -> notifier "Notifies after the transaction closes" "Python call" "Runtime,Async"
unitOfWork -> listCache "Runs the invalidation after commit" "Python call" "Runtime"
unitOfWork -> queueAdapter "Runs the enqueue after commit" "Python call" "Runtime,Async"
repositories -> database "SELECT ... FOR UPDATE, SELECT, INSERT, UPDATE" "SQL" "Runtime"
queries -> database "SELECT with seat counts" "SQL" "Runtime"
unitOfWork -> database "BEGIN and COMMIT" "SQL" "Runtime"

# --- Worker components
redis -> promoteTask "Delivers the task" "Celery (Redis)" "Async"
promoteTask -> sharedCode "Runs PromoteWaitlist through" "Python call"
sharedCode -> database "Reads waitlists, confirms seats, takes row locks" "SQL" "Async"
sharedCode -> redis "Invalidates the list cache after commit" "Redis protocol" "Async"
sharedCode -> email "Sends the promotion email" "SMTP or SES API" "Async"
