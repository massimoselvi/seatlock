{
  "name": "seatlock-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint --cache",
    "typecheck": "vue-tsc --noEmit",
    "knip": "knip",
    "test": "vitest",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test --run && pnpm run build"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^22.20.5",
    "@unocss/eslint-plugin": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "happy-dom": "^21.0.3",
    "knip": "^6.42.1",
    "typescript": "^5.9.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
